{
  "name": "vera-workbench-electron",
  "version": "2.3.2",
  "description": "Annie Electron 封装（窗口/托盘/后端进程管理/打包）",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "cross-env VERA_DEV=1 VERA_DEV_URL=http://localhost:3000 electron .",
    "build-web": "cd \"../frontend\" && npm run build -- --base=./ --mode production",
    "prepare:pkg": "powershell -NoProfile -ExecutionPolicy Bypass -File prepare-package.ps1",
    "dist": "npm run prepare:pkg && electron-builder",
    "dist:dir": "npm run prepare:pkg && electron-builder --dir",
    "build": "npm run build-web && npm run prepare:pkg && electron-builder --win --x64",
    "pack": "npm run build-web && npm run prepare:pkg && electron-builder --win --x64 --dir",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.vera.workbench",
    "productName": "Annie",
    "publish": {
      "provider": "github",
      "owner": "wangnao821-netizen",
      "repo": "annie-workbench"
    },
    "afterPack": "after-pack.js",
    "asar": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.cjs",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "staging/backend",
        "to": "backend",
        "filter": ["**/*"]
      },
      {
        "from": "staging/runtime",
        "to": "runtime",
        "filter": ["**/*"]
      },
      {
        "from": "../frontend/dist",
        "to": "web",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "build/app.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Annie",
      "runAfterFinish": true
    }
  }
}
