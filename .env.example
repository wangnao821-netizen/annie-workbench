# ===== 云端 AI API =====
# 主力模型：Gemini 2.0 Flash（测试用，OpenAI 兼容接口）
GEMINI_API_KEY=your_gemini_api_key_here
# 免 VPN 直连中转地址（可选：若使用国内免代理中转站请输入其接口地址，留空则默认使用官方域名）
# GEMINI_API_BASE=https://api.oneapi.com/v1

# 备选模型：DeepSeek V4-Flash（性价比最高）
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# 免 VPN 直连中转地址（可选）
# DEEPSEEK_API_BASE=https://api.deepseek.com/v1

# 备选模型：GPT-4o mini（DeepSeek 宕机时自动切换）
OPENAI_API_KEY=your_openai_api_key_here

# ===== 路径配置 =====
# 客户文件根目录（AI 从这里读取文件，不同操作系统路径不同）
# macOS:   CLIENT_FILES_ROOT=/Volumes/QChome
# Windows: CLIENT_FILES_ROOT=Z:\QChome
# Linux:   CLIENT_FILES_ROOT=/mnt/nas
CLIENT_FILES_ROOT=/Volumes/QChome

# 项目运行时数据目录（数据库和日志，不要放 NAS 上）
DATA_DIR=./data
LOG_DIR=./logs

# 全局邮件缓冲根目录（VBA 导出的邮件+附件临时存放地，默认 DATA_DIR）
# 隐私要求：不要放客户 NAS 共享盘，Vera 电脑本地数据盘即可，例如 D:\
# EMAIL_BUFFER_ROOT=D:\

# ===== 运行模式 =====
# development | production
ENV=development

# 日志级别：DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
