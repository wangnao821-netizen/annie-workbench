# Vera Workbench 环境变量示例
# 用法：复制本文件为 .env 后填写；启动脚本 run_backend.py 会自动加载 .env。

# ── 必填 ─────────────────────────────────────────────
# 客户文件根目录（AI 从这里读取文件；Windows：Z:\QChome / D:\Clients；macOS：/Volumes/QChome；Linux：/mnt/nas）
CLIENT_FILES_ROOT=

# ── 云端 AI API ──────────────────────────────────────
# 日常对话/中文写作（DeepSeek，主力）
DEEPSEEK_API_KEY=
# 免 VPN 直连中转地址（可选；留空默认官方域名）
# DEEPSEEK_API_BASE=https://api.deepseek.com/v1
# 英文写作/兜底（Gemini 失败时 DeepSeek 接手）
GEMINI_API_KEY=
# 免 VPN 直连中转地址（可选）
# GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai
# 旧版备选模型（当前配置未接入，保留说明）
# OPENAI_API_KEY=

# ── 运行模式 / 路径 ──────────────────────────────────
# development | production（production 严格校验 API Key）
ENV=development
# 日志级别：DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# 运行时数据目录（数据库/日志，不要放 NAS 上）
DATA_DIR=./data
LOG_DIR=./logs
# 全局邮件缓冲根目录（VBA 导出的邮件+附件临时存放地，默认 DATA_DIR；不要放客户 NAS 共享盘）
# EMAIL_BUFFER_ROOT=D:\
# 后端端口（默认 8000）
VERA_PORT=8000
# 统计分桶时区（默认 Australia/Sydney）
ANALYTICS_TZ=Australia/Sydney
# 数据库路径（默认 core/data/assistant.db，一般无需修改）
# LOAN_ASSISTANT_DB_PATH=core/data/assistant.db